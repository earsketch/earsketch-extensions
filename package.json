{
  "name": "earsketch-extensions",
  "version": "0.0.0",
  "description": "Official collection of EarSketch extension panels",
  "private": true,
  "workspaces": [
    "extensions/*",
    "sdk"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint extensions sdk",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:hello-world": "npm run dev --workspace hello-world",
    "build:hello-world": "npm run build --workspace hello-world"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  },
  "license": "MIT"
}

{
  "manifest_version": 1,
  "extension_api_version": "1",
  "name": "Code Minimap",
  "version": "1.0",
  "description": "A simple extension starting point for development",
  "icons": {
    "32": "earsktch_extension_icon_32.png",
    "128": "earsktch_extension_icon_128.png"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "getEditorContents",
    "getPlaybackStatus",
    "sidePanel"
  ]
}